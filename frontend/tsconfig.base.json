{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "paths": {
      "@workspace/types": ["../../packages/types/src"],
      "@workspace/api-client": ["../../packages/api-client/src"],
      "@workspace/hooks": ["../../packages/hooks/src"],
      "@workspace/ui-kit/*": ["../../packages/ui-kit/src/*"]
    }
  }
}
