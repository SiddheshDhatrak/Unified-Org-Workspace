# Database & Cache
DATABASE_URL="postgresql://app_user:supersecretpassword@localhost:5432/workspace?schema=public&connection_limit=10"
REDIS_URL="redis://localhost:6379"

# Application Environment
NODE_ENV="development"
PORT="4000"

# JWT Keypair paths or inline keys (RS256)
# For development/seed purposes, fallback test keys can be autogenerated or provided here
JWT_PRIVATE_KEY="test_private_key_placeholder"
JWT_PUBLIC_KEY="test_public_key_placeholder"

# Security & CORS
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL="30d"
COOKIE_DOMAIN="localhost"
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3001,https://app.workspace.com,https://review.workspace.com"

# External APIs
LLM_API_KEY="optional-llm-api-key-for-digest"
S3_BUCKET="workspace-attachments"
S3_REGION="us-east-1"
S3_ACCESS_KEY="minio_access"
S3_SECRET_KEY="minio_secret"
