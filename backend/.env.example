# Database & Cache
DATABASE_URL="postgresql://app_user:supersecretpassword@localhost:5432/workspace?schema=public&connection_limit=10"
REDIS_URL="redis://localhost:6379"

# Application Environment
# In production, set this to "production" to enforce strict security checks
NODE_ENV="production"
PORT="4000"

# JWT Keypair paths or inline keys (RS256)
# FOR PRODUCTION: You MUST provide real RSA keys. Do not use placeholders!
JWT_PRIVATE_KEY="YOUR_PROD_PRIVATE_KEY_PEM"
JWT_PUBLIC_KEY="YOUR_PROD_PUBLIC_KEY_PEM"

# Security & CORS
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL="30d"
# Update COOKIE_DOMAIN to your actual production domain
COOKIE_DOMAIN=".vercel.app"
# Specify ONLY your trusted frontend domains in production (comma-separated)
CORS_ALLOWED_ORIGINS="https://support-hub-xi-topaz.vercel.app,https://review-hub-pink.vercel.app"

# External APIs
LLM_API_KEY="optional-llm-api-key-for-digest"
S3_BUCKET="workspace-attachments"
S3_REGION="us-east-1"
S3_ACCESS_KEY="minio_access"
S3_SECRET_KEY="minio_secret"

# Frontend URL for generating the invitation links
FRONTEND_URL="https://support-hub-xi-topaz.vercel.app"

# Resend SMTP Configuration
SMTP_HOST="smtp.resend.com"
SMTP_PORT="465"
SMTP_USER="resend"
SMTP_PASS="re_YOUR_API_KEY_HERE"
SMTP_FROM="Unified Workspace <noreply@yourdomain.com>"
