{
  "name": "unified-org-workspace-backend",
  "version": "1.0.0",
  "description": "Production-Grade Backend for Unified Org Workspace (Support Hub + Review Console) with hard tenant isolation, RS256 JWT auth, and append-only audit log.",
  "main": "dist/src/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/src/server.js",
    "dev": "ts-node src/server.ts",
    "worker": "ts-node src/jobs/workers/digest.worker.ts",
    "worker:digest": "ts-node src/jobs/workers/digest.worker.ts",
    "worker:notification": "ts-node src/jobs/workers/notification.worker.ts",
    "worker:prod": "node dist/src/jobs/workers/digest.worker.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "ts-node prisma/seed.ts",
    "test": "jest",
    "test:unit": "jest --testPathPattern=src/tests/unit",
    "test:security": "jest --testPathPattern=src/tests/security --runInBand",
    "lint": "eslint . --ext .ts"
  },
  "dependencies": {
    "@prisma/client": "^5.14.0",
    "argon2": "^0.40.1",
    "bullmq": "^5.7.0",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "diff": "^5.2.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^3.0.3",
    "pino": "^9.1.0",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.2",
    "rate-limiter-flexible": "^5.0.0",
    "uuid": "^9.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/diff": "^5.2.1",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.12.12",
    "@types/node-cron": "^3.0.11",
    "@types/pino-http": "^5.8.4",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/eslint-plugin": "^7.10.0",
    "@typescript-eslint/parser": "^7.10.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "pino-pretty": "^11.0.0",
    "prisma": "^5.14.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  }
}